# Copy to deploy/production.env (it is git-ignored) and fill what you need. Everything is optional.
# HOST, PORT, DB_PATH and WEB_DIR are fixed by compose.yaml and are not set here.

TZ_DISPLAY=Europe/Madrid
FAVORITE_TEAMS=MIN,LAL,PHI
LOG_LEVEL=info

# Translation (module `translation`). Leave empty to disable the button.
DEEPL_API_KEY=

# Web Push (module `push`). Set all three or leave all three empty.
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
