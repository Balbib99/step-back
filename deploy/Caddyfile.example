# Add this block to the Caddyfile that already runs on the Raspberry Pi.
# Caddy and the step-back container must share a Docker network, and only the two of them (see
# PROXY_NETWORK in compose.yaml and "Red privada" in docs/deploy.md).

step-back.duckdns.org {
	# The only protection the app has: nobody gets past this without the password.
	# Make the hash with:   docker run --rm caddy:2 caddy hash-password
	# and paste it after the user name. Never write the password itself here.
	basic_auth {
		CHANGE_ME_USER CHANGE_ME_PASSWORD_HASH
	}

	# HSTS belongs here because only Caddy speaks HTTPS. The rest of the security headers (CSP,
	# nosniff, referrer policy, frame protection) are sent by the app itself, so they stay in
	# step with the code. Do not add includeSubDomains or preload: duckdns.org is not yours.
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	encode zstd gzip

	reverse_proxy step-back:3000
}
