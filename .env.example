# Copy to .env and adjust. All variables are optional; defaults shown.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DB_PATH=./data/step-back.db
TZ_DISPLAY=Europe/Madrid
FAVORITE_TEAMS=MIN,LAL,PHI

# Translation (module `translation`). Leave empty to disable the button.
DEEPL_API_KEY=

# Web Push (module `push`). Set all three or none. Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
