# Copy to .env and adjust. All variables are optional; defaults shown.
NODE_ENV=development
# Loopback by default. In Docker the compose file sets HOST=0.0.0.0.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DB_PATH=./data/step-back.db
# Team crests are downloaded here once (default: a `crests` folder next to the database).
# CRESTS_DIR=./data/crests
# Player photos are downloaded here (default: a `headshots` folder next to the database).
# HEADSHOTS_DIR=./data/headshots
# NEWS_IMAGES_DIR=./data/news-images
# Folder with the built web app. Set by the Docker image; leave empty in development.
# WEB_DIR=./web/dist
TZ_DISPLAY=Europe/Madrid
FAVORITE_TEAMS=MIN,LAL,PHI

# Translation (module `translation`). Leave empty to disable the button.
DEEPL_API_KEY=
# Only if DeepL tells you to use another address. By default a key ending in ":fx" goes to
# api-free.deepl.com and any other key to api.deepl.com.
# DEEPL_API_URL=

# Web Push (module `push`). Set all three or leave all three empty.
# Generate keys: see "Activar las notificaciones" in docs/deploy.md
# Subject example: mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
